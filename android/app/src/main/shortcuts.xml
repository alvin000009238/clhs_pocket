<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@mipmap/clhs_pocket"
        android:shortcutId="schedule"
        android:shortcutLongLabel="@string/shortcut_schedule_long"
        android:shortcutShortLabel="@string/shortcut_schedule_short">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="${applicationId}"
            android:targetClass="com.clhs.score.MainActivity"
            android:data="scoreapp://schedule?entry=launcher_shortcut" />
    </shortcut>
</shortcuts>
